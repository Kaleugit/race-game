{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/gen-governance-core/hooks/session-start.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/telemetry/hooks/record-event.sh\" session_start"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/telemetry/hooks/session-guard.sh\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/gen-governance-core/hooks/inject-level.sh\" l2"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/gen-governance-core/hooks/project-state.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/gen-governance-core/hooks/inject-level.sh\" l3"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/telemetry/hooks/record-event.sh\" prompt"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/telemetry/hooks/drift-guard.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/gen-governance-core/hooks/user-prompt.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/cc-watch/hooks/user-prompt.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/gen-governance-core/hooks/mark-dirty.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/telemetry/hooks/record-event.sh\" tool"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/telemetry/hooks/record-event.sh\" session_end"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/skills/telemetry/hooks/statusline-tap.sh\""
  }
}
